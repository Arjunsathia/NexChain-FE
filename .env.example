# Backend REST API (must end with /api)
VITE_API_BASE_URL=http://localhost:4001/api

# Backend WebSocket (orders/notifications). Optional: derived from the API URL if empty
VITE_WS_URL=ws://localhost:4001

# Binance WebSocket base (no path). Use wss://stream.binance.us:9443 if binance.com is blocked
VITE_BINANCE_WS_URL=wss://stream.binance.com:9443

# Google OAuth: must match GOOGLE_CLIENT_ID in the backend
VITE_GOOGLE_CLIENT_ID=

# Binance public REST (price charts). data-api.binance.vision allows browser requests
VITE_BINANCE_REST_URL=https://data-api.binance.vision
